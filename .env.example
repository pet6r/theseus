# LLM backend: anthropic | claude_code
# - anthropic: direct Anthropic API (requires ANTHROPIC_API_KEY, pay per token)
# - claude_code: Claude Agent SDK via `claude` CLI OAuth (uses Max/Pro subscription)
THESEUS_BACKEND=anthropic

# Required for THESEUS_BACKEND=anthropic. Ignored by claude_code backend.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Path to Ghidra install dir (contains support/analyzeHeadless)
GHIDRA_HOME=C:/ghidra_12.1_PUBLIC

# Where headless project workspace lives
GHIDRA_PROJECT_DIR=./ghidra_projects

# Port for LibGhidraHost HTTP server (Theseus also auto-picks a free port if unset)
LIBGHIDRA_PORT=18080

# Path to ghidrasql binary (built from C++ source). Falls back to PATH lookup.
GHIDRASQL_BIN=

# Optional SOC ingest endpoint
SOC_WEBHOOK_URL=
